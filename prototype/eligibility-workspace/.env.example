# AI generation credentials; keep real values only in .env.local or Vercel secrets
OPENAI_API_KEY=
# Optional. When omitted, the server selects the lowest available supported model.
OPENAI_MODEL=
HEYGEN_API_KEY=

# Source and render services; both are server-side only
OPEN_NOTEBOOK_API_URL=
ARTIFACT_WORKER_URL=
ARTIFACT_WORKER_TOKEN=

# Provisioned by Neon through the Vercel Marketplace
DATABASE_URL=

# Server-owned author identity for the protected prototype deployment
STUDIO_ACTOR_ID=
STUDIO_ACTOR_NAME=

# Provisioned by a private Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Hume server-side credentials; never expose these in browser code
HUME_API_KEY=
HUME_SECRET_KEY=
HUME_CONFIG_ID=

# Fixed synthetic prototype identity
DEMO_LEARNER_ID=demo-learner-blueorigin

# Generate a long random value for the retention cron endpoint
CRON_SECRET=
